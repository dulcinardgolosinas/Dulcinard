# Servidor
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:4000

# MongoDB
MONGO_URI=mongodb+srv://usuario:password@cluster.mongodb.net/dulcinard

# JWT
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Mercado Pago: en producción, el access token de producción (APP_USR-...).
# Nunca lo pongas en el código ni lo subas al repo; solo en Vercel / .env.
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=

# Nodemailer: mail al dueño por cada pedido nuevo. Con Gmail, SMTP_PASS es una
# contraseña de aplicación (myaccount.google.com/apppasswords), no la clave normal.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
OWNER_NOTIFICATION_EMAIL=dulcinardgolosinas@gmail.com

# Admin seed inicial
ADMIN_EMAIL=admin@dulcinard.com
ADMIN_PASSWORD=cambiar-esta-password
